# Copy to .env for local development. NEVER commit .env or put real secrets in this file.
# On Render, set these in the service's Environment tab instead (see DEPLOY.md).

# --- database: Supabase *Session pooler* URL (Project > Connect > Session pooler) ---
# If the password contains special characters, URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- auth: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" ---
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# --- AI (free key from https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_FEEDBACK_MODEL=openai/gpt-oss-120b
AI_DAILY_QUOTA=40

# --- optional: bootstrap admin, created on API start only if no user has this email ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- runtime ---
APP_ENV=development
# comma-separated browser origins allowed to call the API (production: your deployed frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# reverse proxies in front of the API: 0 locally, 1 on Render
TRUSTED_PROXY_HOPS=0
PORT=8787
