{
  "name": "learnloop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "server\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir server --port 8787 --reload --no-access-log",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "setup": "python -m venv server/.venv && server\\.venv\\Scripts\\python.exe -m pip install -r server/requirements.txt",
    "db:upgrade": "server\\.venv\\Scripts\\python.exe -m alembic -c server/alembic.ini upgrade head",
    "db:downgrade": "server\\.venv\\Scripts\\python.exe -m alembic -c server/alembic.ini downgrade -1",
    "db:revision": "server\\.venv\\Scripts\\python.exe -m alembic -c server/alembic.ini revision --autogenerate -m",
    "db:current": "server\\.venv\\Scripts\\python.exe -m alembic -c server/alembic.ini current",
    "test:api": "server\\.venv\\Scripts\\python.exe -m pytest server/tests -q",
    "db:reset": "server\\.venv\\Scripts\\python.exe server/scripts/reset_db.py",
    "db:check": "server\\.venv\\Scripts\\python.exe server/scripts/db_check.py"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@uiw/react-codemirror": "^4.23.0",
    "@xyflow/react": "^12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
